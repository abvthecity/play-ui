{
  "name": "@play-ui/physics",
  "version": "0.1.0",
  "description": "Framework-free motion math for play-ui: springs, release velocity, swipe decisions and throw paths.",
  "keywords": [
    "animation",
    "gesture",
    "motion",
    "physics",
    "spring"
  ],
  "homepage": "https://github.com/abvthecity/play-ui",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abvthecity/play-ui.git",
    "directory": "packages/physics"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@play-ui/utils": "workspace:*"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.5",
    "@play-ui/tsdown-config": "workspace:*",
    "publint": "^0.3.25",
    "tsdown": "^0.23.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
