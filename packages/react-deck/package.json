{
  "name": "@play-ui/react-deck",
  "version": "0.1.0",
  "description": "A headless deck of index cards for React: a pile that deals out into a tabbed folder, flips between facets, and folds back, or rises as a sheet on a phone.",
  "keywords": [
    "accessibility",
    "dialog",
    "headless",
    "motion",
    "react",
    "tabs"
  ],
  "homepage": "https://github.com/abvthecity/play-ui",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abvthecity/play-ui.git",
    "directory": "packages/react-deck"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@play-ui/physics": "workspace:*",
    "@play-ui/utils": "workspace:*"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.5",
    "@play-ui/tsdown-config": "workspace:*",
    "@play-ui/vitest-config": "workspace:*",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "publint": "^0.3.25",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsdown": "^0.23.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3",
    "vitest-browser-react": "^2.3.0"
  },
  "peerDependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  }
}
