{
  "name": "@play-ui/react-cards",
  "version": "0.1.0",
  "description": "A headless, accessible card stack for React: swipe, cycle, dismiss, dock and morph.",
  "keywords": [
    "accessibility",
    "cards",
    "headless",
    "motion",
    "react",
    "swipe"
  ],
  "homepage": "https://github.com/abvthecity/play-ui",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abvthecity/play-ui.git",
    "directory": "packages/react-cards"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.js",
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
